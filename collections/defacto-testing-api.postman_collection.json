        {
          "id": "57a1bac6-6ddc-419d-a27d-6edf3a910a77",
          "name": "/sandbox/iban-generator",
          "request": {
            "name": "/sandbox/iban-generator",
            "description": {
              "content": "\nGenerate a new IBAN that will produce a given scenario on the sandbox, for example a rejected loan.\nEach IBAN can be used as the account of a single counterparty or borrower (a buyer or seller of yours).\nSo, if you want to test the API for several of your counterparties, you will have to generate several of them.\nThe BIC associated to these IBANs is FK2FACTO.\nAlso, if you want to test another scenario on a given business, create a new IBAN and use it in the <code>to_account</code> field of the next invoice and loan that you create for this counterparty.\nFor more information on the scenarios of the sandbox, please refer to the <a href=\"https://developers.getdefacto.com/reference/testing-your-integration\">Testing Multiple Scenarios & Errors</a> section.\nWarning: these IBANs will not work in production.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "sandbox",
                "iban-generator"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "country",
                  "value": "FRA"
                },
                {
                  "disabled": false,
                  "key": "scenario",
                  "value": "SUCCESS"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "*/*"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "Authorization"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            }
          },
          "response": [
            {
              "id": "db40ee9f-2f53-404e-8924-99895a29e2c3",
              "originalRequest": {
                "url": {
                  "path": [
