            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"buyer\": null,\n  \"country\": \"FRA\",\n  \"scenario\": \"SUCCESS\",\n  \"seller\": null\n}",
              "options": {
                "raw": {
