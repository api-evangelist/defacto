        {
          "id": "31856854-e5fc-47d9-ab0d-2d3a63f7cfc9",
          "name": "/sandbox/business-eligible",
          "request": {
            "name": "/sandbox/business-eligible",
            "description": {
              "content": "\nThis endpoint enables you to configure the eligibility of a business.\nPass NOT_ELIGIBLE to make a business non-eligible.\nThen, you'll be able to test how the Defacto API behaves when requesting a loan for a non-eligible business.\nYou can test multiple scenarios:\n(1) when the business is the borrower or\n(2) when the business is on the invoice to finance but is not the borrower.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "sandbox",
                "business-eligible"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
