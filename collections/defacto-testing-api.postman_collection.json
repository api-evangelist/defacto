        {
          "id": "0c3ce262-1cf4-4631-adfc-92ae95861b99",
          "name": "/sandbox/business-generator",
          "request": {
            "name": "/sandbox/business-generator",
            "description": {
              "content": "\nGenerate a fake business for you to use in your test.\nImportant, this endpoint does not create the business but simply return the payload.\nCall `/borrowers` to register this business and generate loan for it\nWarning: these invoices and their IBANs will not work in production.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "sandbox",
                "business-generator"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "country",
                  "value": "FRA"
                },
                {
                  "disabled": false,
                  "key": "is_borrower",
                  "value": "true"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "*/*"
              }
            ],
            "method": "GET",
            "auth": {
