        {
          "id": "56ca4f9a-167b-489e-838e-0907651155c8",
          "name": "/sandbox/invoice-generator",
          "request": {
            "name": "/sandbox/invoice-generator",
            "description": {
              "content": "\n!!! The documentation website is not able to display the full response of this endpoint. The use of the curl command is recommended. !!!\n\nGenerate a fake invoice that will produce a given scenario on the sandbox, for example a rejected loan.\nThe generation will not add the invoice to the list of your invoices. You must do this via API.\nTo achieve this, you can copy the invoice_creation_payload into the payload of the invoice creation API.\nIf you want to test another scenario on a given business, create another fake invoice.\nFor more information on the scenarios of the sandbox, please refer to the <a href=\"https://developers.getdefacto.com/reference/testing-your-integration\">Testing your integration</a> section.\nWarning: these invoices and their IBANs will not work in production.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "sandbox",
                "invoice-generator"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
